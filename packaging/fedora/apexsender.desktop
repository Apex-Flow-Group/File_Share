[Desktop Entry]
Version=1.0
Type=Application
Name=Apex Transfer
Comment=Share files across devices via Wi-Fi
Comment[ar]=مشاركة الملفات بين الأجهزة عبر Wi-Fi
Exec=/usr/bin/apexsender
Icon=apexsender
Terminal=false
Categories=Network;FileTransfer;Utility;
Keywords=file;share;transfer;wifi;
StartupNotify=true
StartupWMClass=com.apexflow.tools.transfer
