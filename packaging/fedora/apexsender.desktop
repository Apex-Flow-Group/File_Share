[Desktop Entry]
Version=1.0
Type=Application
Name=Apex Transfer
Comment=Share files across devices on the local network
Comment[ar]=مشاركة الملفات بين الأجهزة على الشبكة المحلية
Exec=/usr/bin/apexsender
Icon=apexsender
Terminal=false
Categories=Network;FileTransfer;Utility;
Keywords=file;share;transfer;wifi;
StartupNotify=true
StartupWMClass=com.apexflow.tools.transfer
