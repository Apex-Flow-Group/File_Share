<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No plain HTTP from Java/Kotlin code. LAN transfers use dart:io,
         which does not read this file. A <domain> entry cannot hold a CIDR
         range such as 192.168.0.0/16: it matches nothing. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
